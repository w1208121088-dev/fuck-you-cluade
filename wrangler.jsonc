{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gongzhengsuo-market",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MARKET",
        "class_name": "MarketDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MarketDurableObject"]
    }
  ]
}
